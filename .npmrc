# Falla de inmediato si el Node del PATH no es el de engines/.nvmrc (24.x).
engine-strict=true

# Bloquea los scripts pre/post-install de las dependencias: es el vector nº1 de
# malware en el registry. Las excepciones se declaran una a una en
# package.json > pnpm.onlyBuiltDependencies (hoy: sharp, que necesita su
# postinstall para descargar los binarios de libvips).
ignore-scripts=true

# Sin rangos ^ al añadir dependencias: el lockfile deja de ser la única defensa
# frente a una minor comprometida.
save-exact=true

# ⚠️ Pendientes de pnpm 10.x, COMENTADOS a propósito:
#   - minimum-release-age  requiere pnpm >= 10.16
#   - block-exotic-subdeps requiere pnpm >= 10.18
# Con pnpm 9.15 no harían nada y, además, npm/npx los escupe como
# "Unknown project config" en cada invocación. Al subir de major:
# descomentar y verificar con `pnpm config get minimum-release-age`
# que devuelve el valor y no `undefined`.
# minimum-release-age=1440
# block-exotic-subdeps=true
